<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Keorsoft · MeridianUI · Design Tokens for WPF
        Versión 1.1 — Fuente: colors_and_type.css

        Uso — merging en App.xaml:
            <Application.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/ruta/tokens-wpf.xaml"/>
                        MaterialDesignThemes aquí
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Application.Resources>

        Convención de nombres:
            Em* = Emerald      Am* = Amber       In* = Indigo
            Vi* = Violet       Or* = Orange      Kr* = Keorsoft Brand
            Gray* = Neutros    Primary* = Acción  S* = Spacing (Double)
            Fs* = FontSize     Radius* = CornerRadius
    -->

    <!-- ══════════════════════════════════════════════════════════════
         1 · COLORES — Sistema semántico de 5 niveles
         Cada familia tiene 5 variantes: strong / mid / light / pale / bg
         ══════════════════════════════════════════════════════════════ -->

    <!-- Emerald — OK / Ingreso / Éxito / Llegadas -->
    <Color x:Key="EmColor">#FF10B981</Color>
    <Color x:Key="EmMdColor">#FF34D399</Color>
    <Color x:Key="EmLtColor">#FF6EE7B7</Color>
    <Color x:Key="EmPlColor">#FFDCFCE7</Color>
    <Color x:Key="EmBgColor">#FFF0FDF4</Color>
    <SolidColorBrush x:Key="EmBrush"   Color="{StaticResource EmColor}"/>
    <SolidColorBrush x:Key="EmMdBrush" Color="{StaticResource EmMdColor}"/>
    <SolidColorBrush x:Key="EmLtBrush" Color="{StaticResource EmLtColor}"/>
    <SolidColorBrush x:Key="EmPlBrush" Color="{StaticResource EmPlColor}"/>
    <SolidColorBrush x:Key="EmBgBrush" Color="{StaticResource EmBgColor}"/>

    <!-- Amber — Alerta / Pendiente / Rentas / Salidas -->
    <Color x:Key="AmColor">#FFF59E0B</Color>
    <Color x:Key="AmMdColor">#FFFBB95A</Color>
    <Color x:Key="AmLtColor">#FFFDE68A</Color>
    <Color x:Key="AmPlColor">#FFFEF3C7</Color>
    <Color x:Key="AmBgColor">#FFFFFBEB</Color>
    <SolidColorBrush x:Key="AmBrush"   Color="{StaticResource AmColor}"/>
    <SolidColorBrush x:Key="AmMdBrush" Color="{StaticResource AmMdColor}"/>
    <SolidColorBrush x:Key="AmLtBrush" Color="{StaticResource AmLtColor}"/>
    <SolidColorBrush x:Key="AmPlBrush" Color="{StaticResource AmPlColor}"/>
    <SolidColorBrush x:Key="AmBgBrush" Color="{StaticResource AmBgColor}"/>

    <!-- Indigo — Neutro / Referencia / Cargos / Ocupación -->
    <Color x:Key="InColor">#FF6366F1</Color>
    <Color x:Key="InMdColor">#FFA5B4FC</Color>
    <Color x:Key="InLtColor">#FFC7D2FE</Color>
    <Color x:Key="InPlColor">#FFE0E7FF</Color>
    <Color x:Key="InBgColor">#FFEEF2FF</Color>
    <SolidColorBrush x:Key="InBrush"   Color="{StaticResource InColor}"/>
    <SolidColorBrush x:Key="InMdBrush" Color="{StaticResource InMdColor}"/>
    <SolidColorBrush x:Key="InLtBrush" Color="{StaticResource InLtColor}"/>
    <SolidColorBrush x:Key="InPlBrush" Color="{StaticResource InPlColor}"/>
    <SolidColorBrush x:Key="InBgBrush" Color="{StaticResource InBgColor}"/>

    <!-- Violet — Total / Resumen / Abonos / Forecast -->
    <Color x:Key="ViColor">#FF8B5CF6</Color>
    <Color x:Key="ViMdColor">#FFC4B5FD</Color>
    <Color x:Key="ViLtColor">#FFDDD6FE</Color>
    <Color x:Key="ViPlColor">#FFEDE9FE</Color>
    <Color x:Key="ViBgColor">#FFF5F3FF</Color>
    <SolidColorBrush x:Key="ViBrush"   Color="{StaticResource ViColor}"/>
    <SolidColorBrush x:Key="ViMdBrush" Color="{StaticResource ViMdColor}"/>
    <SolidColorBrush x:Key="ViLtBrush" Color="{StaticResource ViLtColor}"/>
    <SolidColorBrush x:Key="ViPlBrush" Color="{StaticResource ViPlColor}"/>
    <SolidColorBrush x:Key="ViBgBrush" Color="{StaticResource ViBgColor}"/>

    <!-- Orange — Gasto / Salida / Advertencia -->
    <Color x:Key="OrColor">#FFF97316</Color>
    <Color x:Key="OrMdColor">#FFFB923C</Color>
    <Color x:Key="OrLtColor">#FFFED7AA</Color>
    <Color x:Key="OrPlColor">#FFFFEDD5</Color>
    <Color x:Key="OrBgColor">#FFFFF7ED</Color>
    <SolidColorBrush x:Key="OrBrush"   Color="{StaticResource OrColor}"/>
    <SolidColorBrush x:Key="OrMdBrush" Color="{StaticResource OrMdColor}"/>
    <SolidColorBrush x:Key="OrLtBrush" Color="{StaticResource OrLtColor}"/>
    <SolidColorBrush x:Key="OrPlBrush" Color="{StaticResource OrPlColor}"/>
    <SolidColorBrush x:Key="OrBgBrush" Color="{StaticResource OrBgColor}"/>

    <!-- Keorsoft Brand Blues — solo para chrome de marca, no para data UI -->
    <Color x:Key="KrBlueColor">#FF0E98F8</Color>
    <Color x:Key="KrBlueMidColor">#FF51B1FB</Color>
    <Color x:Key="KrBluePaleColor">#FFC3D9F0</Color>
    <Color x:Key="KrBlueDarkColor">#FF0B5FA8</Color>
    <Color x:Key="KrInkColor">#FF1C1E26</Color>
    <SolidColorBrush x:Key="KrBlueBrush"     Color="{StaticResource KrBlueColor}"/>
    <SolidColorBrush x:Key="KrBlueMidBrush"  Color="{StaticResource KrBlueMidColor}"/>
    <SolidColorBrush x:Key="KrBluePaleBrush" Color="{StaticResource KrBluePaleColor}"/>
    <SolidColorBrush x:Key="KrBlueDarkBrush" Color="{StaticResource KrBlueDarkColor}"/>
    <SolidColorBrush x:Key="KrInkBrush"      Color="{StaticResource KrInkColor}"/>

    <!-- Material legacy — módulos CFDI / contabilidad -->
    <SolidColorBrush x:Key="CargoBrush" Color="#FF2196F3"/>
    <SolidColorBrush x:Key="AbonoBrush" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="DsctoBrush" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="DevolBrush" Color="#FFF44336"/>

    <!-- Formas de pago SAT -->
    <SolidColorBrush x:Key="PayEfecBrush"  Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="PayTcredBrush" Color="#FF2196F3"/>
    <SolidColorBrush x:Key="PayTdebBrush"  Color="#FF9C27B0"/>
    <SolidColorBrush x:Key="PayTransBrush" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="PayNoneBrush"  Color="#FF9E9E9E"/>

    <!-- Chips de pago — fondo semitransparente (0.15 alpha) -->
    <SolidColorBrush x:Key="PayEfecBgBrush"  Color="#264CAF50"/>
    <SolidColorBrush x:Key="PayTcredBgBrush" Color="#262196F3"/>
    <SolidColorBrush x:Key="PayTdebBgBrush"  Color="#269C27B0"/>
    <SolidColorBrush x:Key="PayTransBgBrush" Color="#26FF9800"/>
    <SolidColorBrush x:Key="PayNoneBgBrush"  Color="#269E9E9E"/>

    <!-- Primary — CTA / botones de acción de página -->
    <Color x:Key="PrimaryColor">#FF1976D2</Color>
    <Color x:Key="PrimaryDarkColor">#FF1565C0</Color>
    <Color x:Key="PrimaryLightColor">#FFBBDEFB</Color>
    <SolidColorBrush x:Key="PrimaryBrush"      Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"  Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>

    <!-- Neutros -->
    <Color x:Key="GrayDarkColor">#FF1C1E26</Color>
    <Color x:Key="Gray700Color">#FF374151</Color>
    <Color x:Key="GrayMutedColor">#FF6B7280</Color>
    <Color x:Key="GrayLineColor">#FFE5E7EB</Color>
    <Color x:Key="GrayFootColor">#FFF9FAFB</Color>
    <Color x:Key="PageBgColor">#FFF2F3F7</Color>
    <SolidColorBrush x:Key="GrayDarkBrush"  Color="{StaticResource GrayDarkColor}"/>
    <SolidColorBrush x:Key="Gray700Brush"   Color="{StaticResource Gray700Color}"/>
    <SolidColorBrush x:Key="GrayMutedBrush" Color="{StaticResource GrayMutedColor}"/>
    <SolidColorBrush x:Key="GrayLineBrush"  Color="{StaticResource GrayLineColor}"/>
    <SolidColorBrush x:Key="GrayFootBrush"  Color="{StaticResource GrayFootColor}"/>
    <SolidColorBrush x:Key="PageBgBrush"    Color="{StaticResource PageBgColor}"/>
    <SolidColorBrush x:Key="WhiteBrush"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- App Shell -->
    <SolidColorBrush x:Key="SidebarBgBrush"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveBgBrush"  Color="{StaticResource InBgColor}"/>
    <SolidColorBrush x:Key="SidebarActiveFgBrush"  Color="{StaticResource InColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBgBrush"   Color="#FFF0F4FF"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"    Color="{StaticResource GrayLineColor}"/>
    <sys:Double x:Key="TitlebarHeight">48</sys:Double>
    <sys:Double x:Key="StatusbarHeight">28</sys:Double>
    <sys:Double x:Key="SidebarWidth">220</sys:Double>
    <sys:Double x:Key="SidebarWidthCollapsed">64</sys:Double>

    <!-- ══════════════════════════════════════════════════════════════
         2 · TIPOGRAFÍA
         ══════════════════════════════════════════════════════════════ -->
    <!-- En WPF desktop, Segoe UI está disponible por sistema.
         Inter como fallback para builds que no tengan Segoe UI. -->
    <FontFamily x:Key="FontMain">Segoe UI, Inter, system-ui</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, JetBrains Mono, Consolas</FontFamily>

    <sys:Double x:Key="Fs9">9</sys:Double>
    <sys:Double x:Key="Fs10">10</sys:Double>
    <sys:Double x:Key="Fs11">11</sys:Double>
    <sys:Double x:Key="Fs12">12</sys:Double>
    <sys:Double x:Key="Fs13">13</sys:Double>
    <sys:Double x:Key="Fs14">14</sys:Double>
    <sys:Double x:Key="Fs16">16</sys:Double>
    <sys:Double x:Key="Fs18">18</sys:Double>
    <sys:Double x:Key="Fs22">22</sys:Double>
    <sys:Double x:Key="Fs28">28</sys:Double>
    <sys:Double x:Key="Fs42">42</sys:Double>

    <!-- ══════════════════════════════════════════════════════════════
         3 · ESPACIADO — Base 4 px
         ══════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="S1">4</sys:Double>
    <sys:Double x:Key="S2">8</sys:Double>
    <sys:Double x:Key="S3">12</sys:Double>
    <sys:Double x:Key="S4">16</sys:Double>
    <sys:Double x:Key="S5">20</sys:Double>
    <sys:Double x:Key="S6">24</sys:Double>
    <sys:Double x:Key="S7">32</sys:Double>
    <sys:Double x:Key="S8">40</sys:Double>

    <!-- Thickness helpers para Padding / Margin -->
    <Thickness x:Key="PaddingCard">16</Thickness>
    <Thickness x:Key="PaddingKpiCard">18 14 18 14</Thickness>
    <Thickness x:Key="PaddingHeader">16 14 16 4</Thickness>
    <Thickness x:Key="PaddingSidebarItem">12 8 12 8</Thickness>
    <Thickness x:Key="MarginSidebarItem">8 1 8 1</Thickness>
    <Thickness x:Key="PaddingButton">16 8 16 8</Thickness>
    <Thickness x:Key="PaddingChip">8 4 8 4</Thickness>
    <Thickness x:Key="PaddingInput">10 6 10 6</Thickness>

    <!-- ══════════════════════════════════════════════════════════════
         4 · RADIOS — CornerRadius
         ══════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ══════════════════════════════════════════════════════════════
         5 · ESTILOS SEMÁNTICOS — TextBlock equivalente a CSS utilities
         Nota WPF: no existe TextTransform como propiedad nativa.
         Para UPPERCASE usa un StringToUpperConverter en el binding
         o establece el texto ya en mayúsculas en el ViewModel.
         ══════════════════════════════════════════════════════════════ -->

    <!-- h-page-title: 22px SemiBold gray-dark -->
    <Style x:Key="HPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"   Value="{StaticResource Fs22}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource GrayDarkBrush}"/>
        <Setter Property="LineHeight" Value="26"/>
    </Style>

    <!-- h-section-title: 18px Bold gray-dark -->
    <Style x:Key="HSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize"   Value="{StaticResource Fs18}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GrayDarkBrush}"/>
    </Style>

    <!-- h-module-title: 22px Bold gray-dark — UPPERCASE en el texto del binding -->
    <Style x:Key="HModuleTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize"   Value="{StaticResource Fs22}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GrayDarkBrush}"/>
    </Style>

    <!-- t-kpi-value: 42px Bold — número hero de KPI -->
    <Style x:Key="TKpiValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"   Value="{StaticResource Fs42}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="42"/>
    </Style>

    <!-- t-kpi-value-md: 28px Bold — número secundario de KPI -->
    <Style x:Key="TKpiValueMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize"   Value="{StaticResource Fs28}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="28"/>
    </Style>

    <!-- t-label: 11px SemiBold muted — label de KPI / meta (UPPERCASE en texto binding) -->
    <Style x:Key="TLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource Fs11}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource GrayMutedBrush}"/>
    </Style>

    <!-- t-meta: 9px Bold muted — metadato muy pequeño (UPPERCASE en texto binding) -->
    <Style x:Key="TMeta" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource Fs9}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GrayMutedBrush}"/>
    </Style>

    <!-- t-body: 13px Regular gray-700 -->
    <Style x:Key="TBody" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource Fs13}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource Gray700Brush}"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>

    <!-- t-body-sm: 12px Regular gray-700 -->
    <Style x:Key="TBodySm" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{StaticResource Fs12}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource Gray700Brush}"/>
    </Style>

    <!-- t-amount: 13px SemiBold — importes monetarios (usar tabular nums vía Run si es necesario) -->
    <Style x:Key="TAmount" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize"   Value="{StaticResource Fs13}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         6 · ESTILOS DE BORDER — Cards y contenedores
         ══════════════════════════════════════════════════════════════ -->

    <!-- card-base: fondo blanco, sin borde, CornerRadius Lg, con Dp1 shadow via Effect -->
    <Style x:Key="CardBase" TargetType="Border">
        <Setter Property="Background"    Value="{StaticResource WhiteBrush}"/>
        <Setter Property="CornerRadius"  Value="{StaticResource RadiusLg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                  Color="#000000" Opacity="0.08" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- kpi-card: fondo blanco, CornerRadius Xl, con Dp1 shadow -->
    <Style x:Key="KpiCard" TargetType="Border">
        <Setter Property="Background"    Value="{StaticResource WhiteBrush}"/>
        <Setter Property="CornerRadius"  Value="{StaticResource RadiusXl}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"       Value="{StaticResource PaddingKpiCard}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                  Color="#000000" Opacity="0.08" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
